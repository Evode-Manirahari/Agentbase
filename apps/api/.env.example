NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://dejavas:dejavas@localhost:5433/dejavas
REDIS_URL=redis://localhost:6380
LOG_LEVEL=info
CONNECTOR_CREDENTIALS_KEY=change-me-32-byte-minimum-local-dev-key
API_PUBLIC_URL=http://localhost:3002
DASHBOARD_URL=http://localhost:3000

# Clerk session-token auth on management endpoints. Leave blank for dev
# (every management endpoint will pass through unauthenticated and the API
# logs a warning at boot). Required before any non-localhost deploy.
CLERK_SECRET_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL=
PUBLIC_BASE_URL=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.objects.deals.read crm.objects.deals.write
HUBSPOT_REDIRECT_URI=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_SCOPES=api refresh_token
SALESFORCE_REDIRECT_URI=
GMAIL_ACCESS_TOKEN=
GMAIL_USER_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.readonly
GMAIL_REDIRECT_URI=
OUTREACH_ACCESS_TOKEN=
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_SCOPES=prospects.all sequenceStates.all tasks.all sequences.read mailboxes.read
OUTREACH_REDIRECT_URI=
APOLLO_API_KEY=
ANTHROPIC_API_KEY=

# Rate limits (Redis sliding window). Per-tool catches single-endpoint
# abuse early; per-agent catches abuse spread across many tools. Set
# RATE_LIMIT_DISABLED=1 to short-circuit (e.g. for load tests). A Redis
# blip fails open so legitimate traffic isn't blocked on infra issues.
RATE_LIMIT_TOOL_PER_MIN=60
RATE_LIMIT_AGENT_PER_MIN=600
RATE_LIMIT_DISABLED=
