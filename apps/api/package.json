    "@agentbase/connector-salesforce": "workspace:*",
    "@agentbase/connector-shell": "workspace:*",
    "@agentbase/db": "workspace:*",
    "@agentbase/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.92.0",
    "@clerk/backend": "^1.21.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@slack/web-api": "^7.9.0",
    "bullmq": "^5.34.10",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
