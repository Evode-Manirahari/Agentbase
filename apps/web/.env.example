API_URL=http://localhost:3002

# Clerk auth — leave both blank for dev mode (web hits the API without
# a Bearer token; API stays in its own dev-mode pass-through). Set both
# to flip auth on; the dashboard will protect every route except /sign-in
# and forward the signed-in user's session JWT to the API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
