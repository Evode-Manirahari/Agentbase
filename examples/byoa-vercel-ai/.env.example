# Your Agentbase API key (created at http://localhost:3000/agents).
# Pick the "Sales Agent" permission profile so the demo tools are scoped right.
AGENTBASE_API_KEY=agb_replace_me

# Where your Agentbase API is running. Defaults to localhost:3002 if unset.
# AGENTBASE_BASE_URL=http://localhost:3002

# Your Anthropic key — the agent's reasoning model. Same key you'd use
# in any other Claude project; it never reaches Agentbase.
ANTHROPIC_API_KEY=sk-ant-…
